pragma solidity ^0.8.20;

import {Test} from "forge-std/Test.sol";
import {CredentialVerifier} from "../src/CredentialVerifier.sol";
import {MockHonkVerifierForPlumbingTest} from "../src/MockHonkVerifierForPlumbingTest.sol";

/// @notice Gas-measurement test matching Chapter 3, Section 3.8.3.
/// Deployment gas and verification gas are logged separately, exactly
/// as the methodology specifies: verification gas is the primary
/// variable, deployment gas is supplementary only.
///
/// Run with:
///   forge test --match-contract CredentialVerifierGasTest -vvv --gas-report
///
/// To measure a REAL scenario's proof instead of the placeholder bytes
/// below, replace `dummyProof` / `dummyPublicInputs` with the actual
/// proof bytes and public inputs produced by `bb prove` for that
/// scenario (see scripts/export_proof_for_solidity.py), and replace
/// MockHonkVerifierForPlumbingTest with the real verifier generated by
/// `bb write_solidity_verifier`.
contract CredentialVerifierGasTest is Test {
    CredentialVerifier public credentialVerifier;
    MockHonkVerifierForPlumbingTest public mockVerifier;

    function setUp() public {
        mockVerifier = new MockHonkVerifierForPlumbingTest();
        credentialVerifier = new CredentialVerifier(address(mockVerifier));
    }

    function test_DeploymentGas_IsReported() public {
        // forge --gas-report captures constructor cost automatically;
        // this test exists mainly to give it something to report on.
        assertTrue(address(credentialVerifier) != address(0));
    }

    function test_VerificationGas_MinimalProof() public {
        bytes memory dummyProof = new bytes(2144); // placeholder size; replace with real proof bytes length
        bytes32[] memory dummyPublicInputs = new bytes32[](1);
        dummyPublicInputs[0] = bytes32(uint256(18)); // e.g. minimum_age

        uint256 gasBefore = gasleft();
        bool ok = credentialVerifier.verifyCredential(dummyProof, dummyPublicInputs);
        uint256 gasUsed = gasBefore - gasleft();

        assertTrue(ok);
        emit log_named_uint("verification_gas_used", gasUsed);
        emit log_named_uint("calldata_size_bytes", dummyProof.length + dummyPublicInputs.length * 32);
    }

    function test_VerificationGas_ScalesWithPublicInputCount() public {
        // Scenario 4 submits more public inputs (registry_root, thresholds)
        // than Scenario 1 -- this test demonstrates how to measure that
        // difference in isolation, holding proof size constant.
        bytes memory dummyProof = new bytes(2144);
        bytes32[] memory manyPublicInputs = new bytes32[](4);
        for (uint256 i = 0; i < 4; i++) {
            manyPublicInputs[i] = bytes32(i + 1);
        }

        uint256 gasBefore = gasleft();
        credentialVerifier.verifyCredential(dummyProof, manyPublicInputs);
        uint256 gasUsed = gasBefore - gasleft();

        emit log_named_uint("verification_gas_used_4_public_inputs", gasUsed);
    }
}
