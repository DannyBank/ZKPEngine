{"noir_version":"1.0.0-beta.22+c57152f91260ecdb9faad4efc20abb14b6d2ece7","hash":"7881633779394182161","abi":{"parameters":[{"name":"age","type":{"kind":"field"},"visibility":"private"},{"name":"income","type":{"kind":"field"},"visibility":"private"},{"name":"country_code","type":{"kind":"field"},"visibility":"private"},{"name":"membership_tier","type":{"kind":"field"},"visibility":"private"},{"name":"minimum_age","type":{"kind":"field"},"visibility":"public"},{"name":"minimum_income","type":{"kind":"field"},"visibility":"public"},{"name":"allowed_countries","type":{"kind":"array","length":3,"type":{"kind":"field"}},"visibility":"public"},{"name":"allowed_membership_tiers","type":{"kind":"array","length":3,"type":{"kind":"field"}},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"51":{"source":"// Scenario 2: Multi-Attribute Disclosure\n// 4 attributes, moderate predicate complexity:\n// two range checks plus two set-membership (whitelist) lookups.\n\nfn is_member(value: Field, allowed_set: [Field; 3]) -> bool {\n    let mut found = false;\n    for i in 0..3 {\n        found |= value == allowed_set[i];\n    }\n    found\n}\n\nfn main(\n    age: Field,\n    income: Field,\n    country_code: Field,\n    membership_tier: Field,\n    minimum_age: pub Field,\n    minimum_income: pub Field,\n    allowed_countries: pub [Field; 3],\n    allowed_membership_tiers: pub [Field; 3],\n) {\n    // Range check 1: age\n    assert(age as u64 >= minimum_age as u64);\n\n    // Range check 2: income\n    assert(income as u64 >= minimum_income as u64);\n\n    // Set-membership lookup 1: country whitelist\n    assert(is_member(country_code, allowed_countries));\n\n    // Set-membership lookup 2: membership tier whitelist\n    assert(is_member(membership_tier, allowed_membership_tiers));\n}\n\n#[test]\nfn test_passes_when_all_predicates_satisfied() {\n    main(25, 5000, 233, 2, 18, 3000, [1, 44, 233], [1, 2, 3]);\n}\n\n#[test(should_fail)]\nfn test_fails_when_country_not_whitelisted() {\n    main(25, 5000, 999, 2, 18, 3000, [1, 44, 233], [1, 2, 3]);\n}\n","path":"/home/dbank/thesis/zkp-credential-benchmark/circuits/scenario2_multi_attr/src/main.nr","function_locations":[{"start":216,"name":"is_member"},{"start":569,"name":"main"},{"start":1015,"name":"test_passes_when_all_predicates_satisfied"},{"start":1149,"name":"test_fails_when_country_not_whitelisted"}]}}}