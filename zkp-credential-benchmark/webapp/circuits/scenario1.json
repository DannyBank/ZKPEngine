{"noir_version":"1.0.0-beta.22+c57152f91260ecdb9faad4efc20abb14b6d2ece7","hash":"1260566789604806399","abi":{"parameters":[{"name":"age","type":{"kind":"field"},"visibility":"private"},{"name":"minimum_age","type":{"kind":"field"},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"51":{"source":"// Scenario 1: Minimal Predicate\n// 1 attribute, minimal range check.\n// Proves: holder's private age satisfies age >= minimum_age,\n// without revealing the actual age.\n\nfn main(age: Field, minimum_age: pub Field) {\n    let age_u64 = age as u64;\n    let minimum_age_u64 = minimum_age as u64;\n    assert(age_u64 >= minimum_age_u64);\n}\n\n#[test]\nfn test_passes_when_age_meets_minimum() {\n    main(25, 18);\n}\n\n#[test(should_fail)]\nfn test_fails_when_age_below_minimum() {\n    main(15, 18);\n}\n","path":"/home/dbank/thesis/zkp-credential-benchmark/circuits/scenario1_minimal/src/main.nr","function_locations":[{"start":214,"name":"main"},{"start":383,"name":"test_passes_when_age_meets_minimum"},{"start":466,"name":"test_fails_when_age_below_minimum"}]}}}